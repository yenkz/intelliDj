# slskd web UI credentials
SLSKD_USERNAME=slskd
SLSKD_PASSWORD=change_me

# Soulseek credentials
SLSKD_SLSK_USERNAME=your_soulseek_username
SLSKD_SLSK_PASSWORD=your_soulseek_password

# Primary API key (optional but recommended)
SLSKD_API_KEY=change_me_long_random

# slskd API endpoint
SLSKD_HOST=http://localhost:5030
SLSKD_URL_BASE=

# Spotify OAuth (for scripts/spotify_import.py)
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# SoundNet audio features fallback (for scripts/spotify_import.py)
# Provides BPM/energy/danceability when Spotify audio-features returns 403
# Get a key at https://rapidapi.com/soundnet-soundnet-default/api/track-analysis
RAPIDAPI_KEY=